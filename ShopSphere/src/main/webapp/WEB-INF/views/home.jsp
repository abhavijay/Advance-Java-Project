<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ShopSphere | Discover your everyday</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head>
<body><header class="nav"><a class="logo" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a>
<form class="search" action="${pageContext.request.contextPath}/" method="get"><input name="q" value="<c:out value='${query}'/>" placeholder="Search sneakers, bags, tech..."><button>Search</button></form>
<nav><a href="${pageContext.request.contextPath}/auth">Account</a><a href="${pageContext.request.contextPath}/cart">Cart</a></nav></header>
<main><section class="hero"><div><p class="eyebrow">THE EVERYDAY EDIT</p><h1>Good finds.<br><span>Better days.</span></h1><p class="hero-copy">Thoughtful essentials for your style, your space, and everything in between.</p><a class="primary" href="#products">Explore collection</a></div><div class="hero-art"><div class="orb"></div><img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=900" alt="Red sneaker"></div></section>
<section id="products" class="products-head"><div><p class="eyebrow">CURATED FOR YOU</p><h2>Popular right now</h2></div><span>Fresh picks, everyday prices</span></section>
<div class="grid"><c:forEach var="p" items="${products}"><article class="product"><div class="product-image"><img src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>"><span class="discount"><c:out value="${p.discount}"/>% OFF</span></div><div class="product-info"><p class="category"><c:out value="${p.category}"/></p><h3><c:out value="${p.name}"/></h3><p class="brand"><c:out value="${p.brand}"/></p><div class="price"><strong>₹<c:out value="${p.salePrice}"/></strong><del>₹<c:out value="${p.price}"/></del></div><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="action" value="add"><button class="add">Add to cart <span>＋</span></button></form></div></article></c:forEach></div>
<c:if test="${empty products}"><p class="empty">No products found. Try another search.</p></c:if>
<section class="benefits"><div>✦ <b>Curated quality</b><span>Everyday favourites</span></div><div>↗ <b>Easy shopping</b><span>Simple, smooth checkout</span></div><div>♡ <b>Made for you</b><span>Find your next favourite</span></div></section>
</main><footer><a class="logo" href="#">Shop<span>Sphere</span></a><p>Small details. Great everyday finds.</p><span>© 2026 ShopSphere · Student demo project</span></footer></body></html>