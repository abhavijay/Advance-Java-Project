<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your Cart | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header class="nav"><a class="logo" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><nav><a href="${pageContext.request.contextPath}/">Continue shopping</a><a href="${pageContext.request.contextPath}/auth">Account</a></nav></header>
<main class="simple"><p class="eyebrow">YOUR SELECTION</p><h1>Your shopping cart</h1><c:choose><c:when test="${empty lines}"><div class="empty-box"><h2>Your cart is waiting for something lovely.</h2><a class="primary" href="${pageContext.request.contextPath}/">Explore products</a></div></c:when><c:otherwise><div class="cart-list"><c:forEach var="line" items="${lines}"><div class="cart-row"><img src="<c:out value='${line.product.imageUrl}'/>" alt=""><div class="cart-details"><h3><c:out value="${line.product.name}"/></h3><p>Quantity: <c:out value="${line.quantity}"/></p><strong>₹<c:out value="${line.lineTotal}"/></strong></div><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${line.product.id}"><input type="hidden" name="action" value="remove"><button class="remove">Remove</button></form></div></c:forEach></div><div class="total"><span>Subtotal</span><strong>₹<c:out value="${total}"/></strong></div><p class="muted">Checkout/payment will be the next module to implement.</p></c:otherwise></c:choose></main><footer><a class="logo" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><span>© 2026 ShopSphere</span></footer></body></html>