<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Account | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header class="nav"><a class="logo" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><nav><a href="${pageContext.request.contextPath}/">Home</a><a href="${pageContext.request.contextPath}/cart">Cart</a></nav></header>
<main class="auth-wrap"><section class="auth-card"><p class="eyebrow">WELCOME TO SHOPSPHERE</p><h1>Your account</h1><p class="muted">Create an account or sign in to continue.</p><% if(request.getAttribute("message")!=null){ %><div class="alert"><%= request.getAttribute("message") %></div><% } %>
<div class="auth-columns"><form method="post" action="${pageContext.request.contextPath}/auth"><h2>Sign in</h2><input type="hidden" name="action" value="login"><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><button class="primary full">Sign in</button></form>
<form method="post" action="${pageContext.request.contextPath}/auth"><h2>Create account</h2><input type="hidden" name="action" value="register"><label>Full name</label><input name="name" required maxlength="100"><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required minlength="8"><button class="primary full">Register</button></form></div></section></main><footer><a class="logo" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><span>Student demo · No real payments</span></footer></body></html>